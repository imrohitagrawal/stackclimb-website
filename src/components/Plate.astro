---
interface Props {
  id: string;
  num: string;
  name: string;
  /* What the system is actually doing, right now. This is the fact the
     audience came for, so it sits in the plate's corner at the top of the
     page rather than inside a 9.6px caption cell four rows down.
     It replaces the GROUND / CLOTH / THREAD swatch tags, which printed the
     site's own paint colours on all seven plates. */
  state?: string;
  theme?: 'dark' | 'light';
  class?: string;
}

const { id, num, name, state, theme = 'dark', class: className } = Astro.props;
---

<section class:list={['plate', className]} id={id} data-plate-theme={theme}>
  <div class="plate-frame">
    <div class="plate-tag">
      <span class="plate-no" aria-hidden="true">Plate Nº {num} — {name}</span>
      {state && <span class="plate-state">{state}</span>}
    </div>
    <slot />
  </div>
</section>

<style>
  .plate-state {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
