---
interface Props {
  id: string;
  num: string;
  name: string;
  /* What the system is actually doing, right now. This is the fact the
     audience came for, so it sits in the plate's corner at the top of the
     page rather than inside a 9.6px caption cell four rows down.
     It replaces the GROUND / CLOTH / THREAD swatch tags, which printed the
     site's own paint colours on all seven plates. */
  state?: string;
  theme?: 'dark' | 'light';
  class?: string;
}

const { id, num, name, state, theme = 'dark', class: className } = Astro.props;
---

{/* `with-state` is decided HERE, at build time. It used to be a runtime
    `.plate:has(.plate-state)` selector, and during streaming parse Chromium
    applied the tag-clearance padding to the state-less hero for one layout
    and removed it on the next — a 54px flicker measured as the whole of a
    stable desktop CLS of 0.123 (found by /impeccable optimize, 08-09). A
    fact the template already knows must not be re-derived by the browser
    mid-parse. */}
<section class:list={['plate', className, { 'with-state': !!state }]} id={id} data-plate-theme={theme}>
  <div class="plate-frame">
    <div class="plate-tag">
      <span class="plate-no" aria-hidden="true">Plate Nº {num} — {name}</span>
      {state && <span class="plate-state">{state}</span>}
    </div>
    <slot />
  </div>
</section>

<style>
  .plate-state {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
