---
/* Package 4B — D57 act 01 rebuilt per RCA-002; rescoped per RCA-005 (P-21,
   owner 2026-08-15): the employer ledger depicts the OVERALL CAREER, not
   one tenure. No employer name renders anywhere in the act — attribution by
   name is performed on /cv (gated, derived per row) and machine-checked by
   the per-job figure binding in proof-data.spec.js. Marked approximate at
   ledger level — never "self-reported" (ruling 1). Capability sentences a
   reader can repeat (P-15) on the right; no status words there —
   NarraTwin's No-Go stays on the overview/plate/project page (ruling 3).

   Accessibility contract, gated by proof-act.spec.js: each column is a
   visible h3; the employer list's accessible name chains heading + the
   APPROXIMATE metadata line (aria-labelledby="proof-a proof-a-meta") so a
   list-jumping screen-reader user hears the qualifier; the capability list
   is described by the NOT CLAIMED line (aria-describedby). The D62
   definition renders adjacent to the right heading — the first rendered
   "StackClimb" on the page is the sentence that defines it. */
import Plate from './Plate.astro';
import { definition, qualifier, employerRows, capabilityRows } from '../data/proof.js';
import '../styles/proof.css';
---

<Plate id="proof">
  <div class="plate-grid">
    <div class="plate-copy">
      <h2 class="plate-title tight">Two ledgers, deliberately kept apart.</h2>
      {/* One sentence, not two — the plan's first ordered cut fired: the act
          measured 1579px at 390 against the 1477 ceiling. */}
      <p>
        Employer outcomes are reported and marked approximate; the independent systems are
        evidence you can inspect — and the two are never averaged into a single number.
      </p>
      <div class="proof-col">
        <h3 id="proof-a" class="proof-label">Employer outcomes</h3>
        <p id="proof-a-meta" class="proof-meta">{qualifier}</p>
        <dl class="ledger proof-ledger" aria-labelledby="proof-a proof-a-meta">
          {
            employerRows.map((r) => (
              <div class="row">
                <dt>{r.t}</dt>
                <dd>{r.d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="links">
        <a href="/cv">The full record</a>
      </div>
    </div>
    <div class="plate-figure">
      <div class="proof-col">
        <h3 id="proof-b" class="proof-label">Independent StackClimb systems</h3>
        <p class="proof-meta">Inspectable evidence · public code</p>
        <p class="proof-defn">{definition}</p>
        <dl class="ledger proof-ledger proof-caps" aria-labelledby="proof-b" aria-describedby="proof-nc">
          {
            capabilityRows.map((r) => (
              <div class="row">
                <dt>{r.t}</dt>
                <dd>{r.d}</dd>
              </div>
            ))
          }
        </dl>
        {/* The GitHub links row was the plan's second ordered cut (390
            ceiling); "public code" survives in the eyebrow and the contact
            plate carries the GitHub button. */}
        <p id="proof-nc" class="proof-meta proof-nc">
          Not claimed — users, customers, revenue, production scale, awards or partnerships
          for any independent system.
        </p>
      </div>
    </div>
  </div>
</Plate>
