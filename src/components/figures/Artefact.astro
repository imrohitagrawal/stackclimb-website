---
/* One record card, used by the hero and every project plate.
 *
 * The rule it exists to enforce (DESIGN.md, The Lit-Surface Rule): a figure
 * holds a REAL artefact at a size you can read. Never a grey placeholder bar.
 * The four project figures used to draw lorem bars, and against the near-black
 * grounds they read as an unfinished wireframe — on a page whose headline is
 * "AI that shows its work".
 *
 * Every value passed to this component is copied from a named file or measured
 * by a command, and `source` says which. If a fact cannot be traced that way it
 * does not go on a card.
 */
interface Field {
  k: string;
  v: string;
}

interface Props {
  /* What the record is — the document or run being quoted. */
  kind: string;
  /* The one-word outcome. Styled by `tone`. */
  verdict: string;
  tone?: 'pass' | 'fail' | 'neutral';
  /* The quoted line, verbatim where there is one. */
  line?: string;
  fields: Field[];
  /* Where it came from and how to check it. */
  source: string;
}

const { kind, verdict, tone = 'neutral', line, fields, source } = Astro.props;
---

<figure class="artefact">
  <div class="lit-surface card">
    <p class="kind">{kind}</p>
    <p class="verdict"><span class:list={['mark', tone]}>{verdict}</span></p>
    {line && <p class="said">{line}</p>}
    <dl class="fields">
      {
        fields.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <figcaption>{source}</figcaption>
</figure>

<style>
  .artefact { margin: 0; display: grid; gap: 0.9rem; align-content: center; }
  .card { padding: clamp(1.4rem, 2.6vw, 2.1rem); display: grid; gap: 0.85rem; }

  .kind {
    /* Was 0.62rem (9.92px). The critique measured this line — the file path,
       hash and date that persuade an engineer — as the least legible text on
       the page. The provenance has earned 11px (A2, finding 5). */
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.68;
  }

  .verdict { display: flex; align-items: center; gap: 0.7rem; }
  .verdict::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .mark {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.3rem 0.62rem;
  }
  /* Bordeaux and viridian, already in the palette. Measured on the lit surface:
     bordeaux 10.45:1, viridian 8.10:1 — both well clear of AA. Colour is never
     the only signal; the word itself says Go, No-Go, Refused or Passed. */
  .mark.fail { color: #5e2233; }
  .mark.pass { color: #1e4f46; }
  .mark.neutral { color: color-mix(in srgb, var(--ink) 78%, transparent); }

  .said {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-style: italic;
    line-height: 1.34;
    max-width: 34ch;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.6rem;
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .fields dt {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.68;
  }
  .fields dd {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }

  figcaption {
    font-size: 0.74rem;
    line-height: 1.5;
    opacity: 0.78;
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .said { max-width: none; }
  }
</style>
