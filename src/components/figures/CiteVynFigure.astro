---
// CiteVyn's portrait: a document standing for itself — verbatim quote block,
// numbered citation tabs, a refusal slot left honestly empty, and the golden
// gate bar that every release must pass.
---

<svg class="figure" viewBox="0 0 420 560" role="img" aria-labelledby="cv-title">
  <title id="cv-title">
    A document figure: a quoted answer with numbered citation tabs, a refusal slot left
    empty where no source exists, and a 50-of-50 golden release gate at its foot.
  </title>

  <!-- paper -->
  <rect x="70" y="30" width="280" height="474" rx="4" fill="#f2ebdd"></rect>
  <path d="M350 30 L350 62 L318 30 Z" fill="#ddd2ba"></path>

  <!-- masthead -->
  <rect x="100" y="66" width="168" height="11" rx="2" fill="#16213c" opacity="0.88"></rect>
  <rect x="100" y="86" width="110" height="6" rx="2" fill="#16213c" opacity="0.4"></rect>

  <!-- body lines -->
  <g fill="#16213c" opacity="0.32">
    <rect x="100" y="112" width="220" height="6" rx="2"></rect>
    <rect x="100" y="126" width="204" height="6" rx="2"></rect>
    <rect x="100" y="140" width="216" height="6" rx="2"></rect>
    <rect x="100" y="154" width="150" height="6" rx="2"></rect>
  </g>

  <!-- verbatim quote block -->
  <g data-anchor="cite-quote">
    <rect x="100" y="176" width="220" height="76" fill="#faf5ea" stroke="#c99b3f" stroke-width="1.5"></rect>
    <rect x="100" y="176" width="4" height="76" fill="#7a3247"></rect>
    <text x="114" y="216" font-family="Didot, 'Bodoni MT', serif" font-size="40" fill="#7a3247">“</text>
    <g fill="#16213c" opacity="0.5">
      <rect x="140" y="192" width="160" height="5" rx="2"></rect>
      <rect x="140" y="206" width="146" height="5" rx="2"></rect>
      <rect x="140" y="220" width="154" height="5" rx="2"></rect>
    </g>
  </g>

  <!-- citation tabs, overhanging the page edge -->
  <g data-anchor="cite-tabs">
    <g font-family="Archivo, Arial, sans-serif" font-size="12" font-weight="700" text-anchor="middle">
      <rect x="336" y="182" width="28" height="22" rx="3" fill="#c99b3f"></rect>
      <text x="350" y="197" fill="#16213c">1</text>
      <rect x="336" y="210" width="28" height="22" rx="3" fill="#c99b3f"></rect>
      <text x="350" y="225" fill="#16213c">2</text>
      <rect x="336" y="238" width="28" height="22" rx="3" fill="#c99b3f"></rect>
      <text x="350" y="253" fill="#16213c">3</text>
    </g>
    <g stroke="#c99b3f" stroke-width="1" stroke-dasharray="3 3">
      <path d="M336 193 L300 197"></path>
      <path d="M336 221 L286 211"></path>
      <path d="M336 249 L294 225"></path>
    </g>
  </g>

  <!-- refusal slot: the paragraph that was not invented -->
  <g data-anchor="cite-refusal">
    <rect
      x="100" y="286" width="220" height="62"
      fill="none" stroke="#16213c" stroke-width="1.2" stroke-dasharray="5 4"
    ></rect>
    <g stroke="#16213c" opacity="0.16">
      <path d="M104 344 L158 290"></path>
      <path d="M140 344 L194 290"></path>
      <path d="M176 344 L230 290"></path>
      <path d="M212 344 L266 290"></path>
      <path d="M248 344 L302 290"></path>
    </g>
    <text
      x="210" y="313" text-anchor="middle"
      font-family="Archivo, Arial, sans-serif" font-size="11.5" font-weight="700"
      letter-spacing="2" fill="#16213c"
    >REFUSED — NO SOURCE</text>
    <text
      x="210" y="330" text-anchor="middle"
      font-family="Archivo, Arial, sans-serif" font-size="9" letter-spacing="1"
      fill="#16213c" opacity="0.6"
    >returned instead of guessed</text>
  </g>

  <!-- more body -->
  <g fill="#16213c" opacity="0.32">
    <rect x="100" y="368" width="220" height="6" rx="2"></rect>
    <rect x="100" y="382" width="188" height="6" rx="2"></rect>
  </g>

  <!-- the golden gate -->
  <g data-anchor="cite-gate">
    <text
      x="100" y="424" font-family="Archivo, Arial, sans-serif" font-size="9.5"
      font-weight="700" letter-spacing="2" fill="#16213c" opacity="0.65"
    >GOLDEN GATE</text>
    <rect x="100" y="432" width="220" height="16" rx="8" fill="none" stroke="#16213c" stroke-width="1.2"></rect>
    <g fill="#c99b3f">
      <rect x="104" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="126" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="148" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="170" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="192" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="214" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="236" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="258" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="280" y="436" width="17.6" height="8" rx="4"></rect>
      <rect x="298" y="436" width="17.6" height="8" rx="4"></rect>
    </g>
    <text
      x="320" y="470" text-anchor="end"
      font-family="Archivo, Arial, sans-serif" font-size="13" font-weight="700"
      fill="#16213c"
    >50 / 50 — a red case blocks the ship</text>
  </g>
</svg>
