---
// The portfolio, fitted: a full-length tailored figure whose garments are the systems.
// Jacket panels — CiteVyn (bordeaux) and Quorum (viridian); vest — SaafSaans (dusk);
// trousers — NarraTwin (mauve) and the established record (ink); pocket square — private work.
// Ochre is the thread: stitch seams, buttons, tie, and the sapeur's gold brogues.
---

<svg
  class="figure hero-figure"
  viewBox="0 0 360 660"
  role="img"
  aria-labelledby="hf-title"
>
  <title id="hf-title">
    A full-length tailored figure assembled from the portfolio itself: each garment is one
    system, named in the strip below.
  </title>

  <!-- ground shadow -->
  <ellipse cx="180" cy="642" rx="104" ry="9" fill="#0c1226" opacity="0.55"></ellipse>

  <!-- trousers -->
  <g data-anchor="g-narratwin">
    <path d="M138 372 L180 372 L178 618 L140 618 C 134 530 134 450 138 372 Z" fill="#5c5568"></path>
    <path d="M159 380 L158 612" stroke="#4a4453" stroke-width="2" fill="none"></path>
    <rect x="139" y="600" width="40" height="12" rx="3" fill="#4a4453"></rect>
  </g>
  <path d="M180 372 L222 372 C 226 450 226 530 220 618 L182 618 Z" fill="#2a365e"></path>
  <path d="M201 380 L202 612" stroke="#222c4e" stroke-width="2" fill="none"></path>
  <rect x="181" y="600" width="40" height="12" rx="3" fill="#222c4e"></rect>

  <!-- gold brogues — the sapeur's signature -->
  <path d="M132 612 C 130 626 138 632 158 632 L180 632 L180 616 L140 612 Z" fill="#c99b3f"></path>
  <path d="M228 612 C 230 626 222 632 202 632 L180 632 L180 616 L220 612 Z" fill="#b8892f"></path>
  <path d="M140 622 L176 624" stroke="#a5791f" stroke-width="1.5" fill="none"></path>
  <path d="M220 622 L184 624" stroke="#a5791f" stroke-width="1.5" fill="none"></path>

  <!-- shirt, collar, tie -->
  <rect x="158" y="148" width="44" height="120" fill="#f2ebdd"></rect>
  <path d="M180 150 L170 162 L180 262 L190 162 Z" fill="#c99b3f"></path>
  <path d="M174 158 L186 158 L183 166 L177 166 Z" fill="#b8892f"></path>
  <circle cx="180" cy="196" r="2" fill="#16213c" opacity="0.55"></circle>

  <!-- vest — SaafSaans -->
  <g data-anchor="g-saafsaans">
    <path
      d="M136 250 L158 236 L180 258 L202 236 L224 250 L219 372 L141 372 Z"
      fill="#3e6e93"
    ></path>
    <path d="M136 250 L158 236 L166 250 L146 262 Z" fill="#356184"></path>
    <path d="M224 250 L202 236 L194 250 L214 262 Z" fill="#356184"></path>
    <circle cx="180" cy="288" r="3.4" fill="#c99b3f"></circle>
    <circle cx="180" cy="316" r="3.4" fill="#c99b3f"></circle>
    <circle cx="180" cy="344" r="3.4" fill="#c99b3f"></circle>
    <path d="M148 330 L166 330" stroke="#2c5474" stroke-width="2.5" fill="none"></path>
    <path d="M194 330 L212 330" stroke="#2c5474" stroke-width="2.5" fill="none"></path>
  </g>

  <!-- jacket left panel — CiteVyn -->
  <g data-anchor="g-citevyn">
    <path
      d="M92 196 C 96 164 130 144 160 146 L156 388 L118 378 C 96 316 90 248 92 196 Z"
      fill="#7a3247"
    ></path>
    <!-- notched lapel -->
    <path d="M160 146 L142 224 L120 200 C 126 170 142 152 160 146 Z" fill="#8e4157"></path>
    <path d="M142 224 L128 212" stroke="#5e2233" stroke-width="2" fill="none"></path>
    <!-- ochre stitch seam along the lapel and hem -->
    <path d="M158 152 L143 218" stroke="#c99b3f" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.85" fill="none"></path>
    <path d="M120 372 L152 380" stroke="#c99b3f" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.7" fill="none"></path>
    <!-- flap pocket and button -->
    <rect x="112" y="320" width="34" height="9" rx="3" fill="#5e2233"></rect>
    <circle cx="150" cy="300" r="3" fill="#c99b3f"></circle>
    <!-- sleeve with cuff and hand -->
    <path d="M92 200 C 74 240 70 320 82 384 L108 388 C 100 320 100 260 108 210 Z" fill="#6e2c40"></path>
    <rect x="82" y="384" width="26" height="12" rx="4" fill="#f2ebdd"></rect>
    <path d="M84 396 C 82 412 90 420 98 418 C 106 416 108 404 105 396 Z" fill="#e4dac6"></path>
  </g>

  <!-- jacket right panel — Quorum -->
  <g data-anchor="g-quorum">
    <path
      d="M268 196 C 264 164 230 144 200 146 L204 388 L242 378 C 264 316 270 248 268 196 Z"
      fill="#2a6b5e"
    ></path>
    <path d="M200 146 L218 224 L240 200 C 234 170 218 152 200 146 Z" fill="#337a6b"></path>
    <path d="M218 224 L232 212" stroke="#1e4f46" stroke-width="2" fill="none"></path>
    <path d="M202 152 L217 218" stroke="#c99b3f" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.85" fill="none"></path>
    <path d="M240 372 L208 380" stroke="#c99b3f" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.7" fill="none"></path>
    <rect x="214" y="320" width="34" height="9" rx="3" fill="#1e4f46"></rect>
    <circle cx="210" cy="300" r="3" fill="#c99b3f"></circle>
    <path d="M268 200 C 286 240 290 320 278 384 L252 388 C 260 320 260 260 252 210 Z" fill="#245c50"></path>
    <rect x="252" y="384" width="26" height="12" rx="4" fill="#f2ebdd"></rect>
    <path d="M276 396 C 278 412 270 420 262 418 C 254 416 252 404 255 396 Z" fill="#e4dac6"></path>
  </g>

  <!-- pocket square — the private work, kept close to the chest -->
  <g data-anchor="g-private">
    <path d="M124 246 L148 246 L136 228 Z" fill="#c99b3f"></path>
    <path d="M128 246 L136 236 L144 246" stroke="#a5791f" stroke-width="1" fill="none"></path>
  </g>

  <!-- head: neck, flat hair, sapeur glasses -->
  <rect x="170" y="128" width="20" height="24" fill="#e4dac6"></rect>
  <circle cx="180" cy="100" r="32" fill="#f2ebdd"></circle>
  <path d="M148 96 C 148 74 164 62 180 62 C 196 62 212 74 212 96 C 204 84 194 80 180 80 C 166 80 156 84 148 96 Z" fill="#16213c"></path>
  <g fill="none" stroke="#16213c" stroke-width="2.5">
    <circle cx="167" cy="100" r="8.5"></circle>
    <circle cx="193" cy="100" r="8.5"></circle>
    <path d="M175.5 100 L184.5 100"></path>
    <path d="M158.5 98 L152 94"></path>
    <path d="M201.5 98 L208 94"></path>
  </g>
  <!-- collar points over the jacket -->
  <path d="M162 148 L180 162 L170 148 Z" fill="#f2ebdd"></path>
  <path d="M198 148 L180 162 L190 148 Z" fill="#f2ebdd"></path>
</svg>
