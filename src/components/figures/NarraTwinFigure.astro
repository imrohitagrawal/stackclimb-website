---
// NarraTwin's portrait, ghosted: a film frame that exists, held shut by a
// three-latch release gate. The stamp says what its own review says: No-Go.
---

<svg class="figure" viewBox="0 0 420 560" role="img" aria-labelledby="nt-title">
  <title id="nt-title">
    A ghosted film frame held shut by a gate with three latches — claim evaluation, consent,
    release readiness — stamped No-Go by its own review.
  </title>

  <!-- ghosted film frame -->
  <g data-anchor="n-frame" opacity="0.5">
    <rect x="84" y="56" width="252" height="384" rx="6" fill="none" stroke="#f2ebdd" stroke-width="1.5"></rect>
    <g fill="#f2ebdd" opacity="0.4">
      <rect x="64" y="72" width="12" height="18" rx="3"></rect>
      <rect x="64" y="122" width="12" height="18" rx="3"></rect>
      <rect x="64" y="172" width="12" height="18" rx="3"></rect>
      <rect x="64" y="222" width="12" height="18" rx="3"></rect>
      <rect x="64" y="272" width="12" height="18" rx="3"></rect>
      <rect x="64" y="322" width="12" height="18" rx="3"></rect>
      <rect x="64" y="372" width="12" height="18" rx="3"></rect>
      <rect x="344" y="72" width="12" height="18" rx="3"></rect>
      <rect x="344" y="122" width="12" height="18" rx="3"></rect>
      <rect x="344" y="172" width="12" height="18" rx="3"></rect>
      <rect x="344" y="222" width="12" height="18" rx="3"></rect>
      <rect x="344" y="272" width="12" height="18" rx="3"></rect>
      <rect x="344" y="322" width="12" height="18" rx="3"></rect>
      <rect x="344" y="372" width="12" height="18" rx="3"></rect>
    </g>
    <!-- script inside: avatar, waveform, lines -->
    <circle cx="150" cy="120" r="20" fill="#f2ebdd" opacity="0.35"></circle>
    <g fill="#f2ebdd" opacity="0.3">
      <rect x="184" y="106" width="120" height="6" rx="2"></rect>
      <rect x="184" y="122" width="96" height="6" rx="2"></rect>
    </g>
    <path
      d="M110 180 L118 172 L126 188 L134 164 L142 196 L150 174 L158 186 L166 170 L174 190 L182 178 L190 184 L198 172 L206 188 L214 176 L222 182 L230 168 L238 190 L246 180 L254 186 L262 174 L270 182 L278 178 L286 184 L294 176 L302 180"
      fill="none" stroke="#f2ebdd" stroke-width="1.5" opacity="0.4"
    ></path>
    <g fill="#f2ebdd" opacity="0.25">
      <rect x="110" y="330" width="196" height="6" rx="2"></rect>
      <rect x="110" y="346" width="170" height="6" rx="2"></rect>
      <rect x="110" y="362" width="184" height="6" rx="2"></rect>
      <rect x="110" y="378" width="140" height="6" rx="2"></rect>
    </g>
  </g>

  <!-- the gate, full opacity: it is the working part -->
  <g data-anchor="n-gate">
    <rect x="48" y="238" width="324" height="46" rx="6" fill="#38333f" stroke="#c99b3f" stroke-width="1.5"></rect>
    <circle cx="352" cy="261" r="7" fill="#c99b3f"></circle>
    <path d="M344 250 C 344 240 360 240 360 250" fill="none" stroke="#c99b3f" stroke-width="2.5"></path>
  </g>
  <g data-anchor="n-latches">
    <g font-family="Archivo, Arial, sans-serif" font-size="9" font-weight="700" letter-spacing="1.2" text-anchor="middle">
      <rect x="62" y="247" width="86" height="28" rx="3" fill="#f2ebdd"></rect>
      <text x="105" y="265" fill="#16213c">CLAIM EVAL</text>
      <rect x="158" y="247" width="86" height="28" rx="3" fill="#f2ebdd"></rect>
      <text x="201" y="265" fill="#16213c">CONSENT</text>
      <rect x="254" y="247" width="86" height="28" rx="3" fill="#f2ebdd"></rect>
      <text x="297" y="265" fill="#16213c">RELEASE</text>
    </g>
  </g>

  <!-- the honest stamp -->
  <g transform="rotate(-7 250 140)">
    <rect
      x="188" y="108" width="128" height="52" rx="4"
      fill="none" stroke="#c99b3f" stroke-width="2.5"
    ></rect>
    <text
      x="252" y="146" text-anchor="middle"
      font-family="Didot, 'Bodoni MT', serif" font-size="34" font-weight="700"
      fill="#c99b3f" letter-spacing="4"
    >NO-GO</text>
  </g>
  <text
    x="210" y="516" text-anchor="middle"
    font-family="Archivo, Arial, sans-serif" font-size="9" font-weight="600"
    letter-spacing="1.6" fill="#f2ebdd" opacity="0.75"
  >HELD BY ITS OWN GATES — WHICH IS THE POINT</text>
</svg>
