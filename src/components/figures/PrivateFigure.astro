---
// The private work: two garment bags, zipped. Named, not shown.
//
// The bags are 128 user units wide and the name tags 115.4 x 46, which is the
// DEF-63 redraw. Both were smaller and the type on them was 9 and 9.5 user
// units — 4.76px on a 320px phone, the smallest text on the site, and
// `AEGIS-CONTRACTS` overflowed its own 96-unit tag at every width. The viewBox
// is deliberately unchanged so the figure's rendered box, and every plate
// height measured against it, stay exactly where they were. Working: the
// rendered size of this text is `declared x (figure width in px / 420)`, so it
// is gated on the render by tests/type-floor.spec.js, not on the number here.
---

<svg class="figure private-figure" viewBox="0 0 420 340" role="img" aria-labelledby="pv-title">
  <title id="pv-title">Two zipped garment bags on a rail, each carrying a name tag.</title>

  <!-- rail -->
  <rect x="40" y="34" width="340" height="4" rx="2" fill="#16213c" opacity="0.5"></rect>

  <!-- bag one — EvalAxis -->
  <g>
    <path d="M94 38 L94 52" stroke="#16213c" stroke-width="2.5" fill="none"></path>
    <path
      d="M30 110 C 30 76 59.54 54 94 54 C 128.46 54 158 76 158 110
         L158 296 C158 302 151.85 306 145.69 306
         L42.31 306 C 36.15 306 30 302 30 296 Z"
      fill="#8f8672"
    ></path>
    <path d="M94 62 L94 298" stroke="#16213c" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.55" fill="none"></path>
    <circle cx="94" cy="120" r="5" fill="none" stroke="#c99b3f" stroke-width="2"></circle>
    <path d="M52.15 296 L135.85 296" stroke="#c99b3f" stroke-width="1.4" stroke-dasharray="4 3" fill="none"></path>
    <g transform="rotate(-6 94 220)">
      <rect x="36.3" y="197" width="115.4" height="46" rx="2" fill="#f2ebdd" stroke="#16213c" stroke-opacity="0.4"></rect>
      <text
        x="94" y="225.73" text-anchor="middle"
        font-family="Archivo, Arial, sans-serif" font-size="16" font-weight="700"
        letter-spacing="0.45" fill="#16213c"
      >EVALAXIS</text>
    </g>
  </g>

  <!-- bag two — Aegis Contracts -->
  <g>
    <path d="M326 38 L326 52" stroke="#16213c" stroke-width="2.5" fill="none"></path>
    <path
      d="M262 110 C 262 76 291.54 54 326 54 C 360.46 54 390 76 390 110
         L390 296 C390 302 383.85 306 377.69 306
         L274.31 306 C 268.15 306 262 302 262 296 Z"
      fill="#7f775f"
    ></path>
    <path d="M326 62 L326 298" stroke="#16213c" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.55" fill="none"></path>
    <circle cx="326" cy="120" r="5" fill="none" stroke="#c99b3f" stroke-width="2"></circle>
    <path d="M284.15 296 L367.85 296" stroke="#c99b3f" stroke-width="1.4" stroke-dasharray="4 3" fill="none"></path>
    <g transform="rotate(5 326 220)">
      <rect x="268.3" y="197" width="115.4" height="46" rx="2" fill="#f2ebdd" stroke="#16213c" stroke-opacity="0.4"></rect>
      <text
        x="326" y="216.13" text-anchor="middle"
        font-family="Archivo, Arial, sans-serif" font-size="16" font-weight="700"
        letter-spacing="0.45" fill="#16213c"
      ><tspan x="326">AEGIS</tspan><tspan x="326" dy="19.2">CONTRACTS</tspan></text>
    </g>
  </g>
</svg>
