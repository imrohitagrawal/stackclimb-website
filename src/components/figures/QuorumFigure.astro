---
// Quorum's portrait: four model delegates standing in parallel, critique threads
// crossing between them, converging into one five-field synthesis — with the cost
// tag shown before anything runs.
---

<svg class="figure" viewBox="0 0 420 560" role="img" aria-labelledby="qr-title">
  <title id="qr-title">
    Four model columns debate across crossing threads and converge into one synthesis block
    with five fields; a cost tag hangs above — approved before anything runs.
  </title>

  <!-- cost tag -->
  <g data-anchor="q-cost">
    <path d="M96 92 C 76 76 64 60 60 44" fill="none" stroke="#f2ebdd" stroke-width="1.5" opacity="0.7"></path>
    <g transform="translate(96 66) rotate(-8)">
      <rect width="166" height="44" rx="6" fill="#c99b3f"></rect>
      <circle cx="14" cy="22" r="4.5" fill="#1e4f46"></circle>
      <text
        x="30" y="19" font-family="Archivo, Arial, sans-serif" font-size="11"
        font-weight="700" letter-spacing="1.2" fill="#16213c"
      >COST SHOWN FIRST</text>
      <text
        x="30" y="34" font-family="Archivo, Arial, sans-serif" font-size="8.5"
        letter-spacing="0.6" fill="#16213c" opacity="0.75"
      >nothing runs unapproved</text>
    </g>
  </g>

  <!-- four delegates -->
  <g data-anchor="q-models">
    <g fill="#f2ebdd">
      <rect x="58" y="150" width="56" height="164" rx="6"></rect>
      <rect x="146" y="162" width="56" height="152" rx="6"></rect>
      <rect x="234" y="154" width="56" height="160" rx="6"></rect>
      <rect x="322" y="170" width="56" height="144" rx="6"></rect>
    </g>
    <g fill="#16213c" opacity="0.14">
      <rect x="58" y="150" width="56" height="18" rx="6"></rect>
      <rect x="146" y="162" width="56" height="18" rx="6"></rect>
      <rect x="234" y="154" width="56" height="18" rx="6"></rect>
      <rect x="322" y="170" width="56" height="18" rx="6"></rect>
    </g>
    <g fill="#16213c" opacity="0.3">
      <rect x="66" y="182" width="40" height="5" rx="2"></rect>
      <rect x="66" y="196" width="34" height="5" rx="2"></rect>
      <rect x="66" y="210" width="38" height="5" rx="2"></rect>
      <rect x="154" y="194" width="40" height="5" rx="2"></rect>
      <rect x="154" y="208" width="30" height="5" rx="2"></rect>
      <rect x="154" y="222" width="36" height="5" rx="2"></rect>
      <rect x="242" y="186" width="40" height="5" rx="2"></rect>
      <rect x="242" y="200" width="36" height="5" rx="2"></rect>
      <rect x="242" y="214" width="32" height="5" rx="2"></rect>
      <rect x="330" y="202" width="40" height="5" rx="2"></rect>
      <rect x="330" y="216" width="30" height="5" rx="2"></rect>
      <rect x="330" y="230" width="36" height="5" rx="2"></rect>
    </g>
    <g
      font-family="Archivo, Arial, sans-serif" font-size="10" font-weight="600"
      letter-spacing="1" fill="#f2ebdd" text-anchor="middle"
    >
      <text x="86" y="332">GPT-4O-MINI</text>
      <text x="174" y="332">HAIKU 4.5</text>
      <text x="262" y="332">GEMINI 2.5</text>
      <text x="350" y="332">DEEPSEEK 3.1</text>
    </g>
  </g>

  <!-- critique threads: two rounds, crossing -->
  <g data-anchor="q-debate" fill="none" stroke="#c99b3f" stroke-width="1.5">
    <path d="M114 236 C 160 208 200 268 234 240" opacity="0.9"></path>
    <path d="M202 226 C 250 200 290 258 322 232" opacity="0.9"></path>
    <path d="M114 260 C 190 300 250 208 322 252" opacity="0.6"></path>
    <path d="M86 250 C 170 320 290 320 350 258" opacity="0.6"></path>
    <circle cx="234" cy="240" r="2.6" fill="#c99b3f" stroke="none"></circle>
    <circle cx="322" cy="232" r="2.6" fill="#c99b3f" stroke="none"></circle>
    <circle cx="322" cy="252" r="2.6" fill="#c99b3f" stroke="none"></circle>
    <circle cx="350" cy="258" r="2.6" fill="#c99b3f" stroke="none"></circle>
  </g>

  <!-- convergence -->
  <g stroke="#f2ebdd" stroke-width="1" opacity="0.4" fill="none">
    <path d="M86 314 L110 368"></path>
    <path d="M174 314 L182 368"></path>
    <path d="M262 314 L254 368"></path>
    <path d="M350 314 L326 368"></path>
  </g>

  <!-- synthesis block: five fields, disagreement included -->
  <g data-anchor="q-synth">
    <rect x="64" y="368" width="314" height="138" rx="8" fill="#143b34" stroke="#f2ebdd" stroke-opacity="0.35"></rect>
    <g
      font-family="Archivo, Arial, sans-serif" font-size="10" font-weight="600"
      letter-spacing="1.4" fill="#f2ebdd"
    >
      <text x="82" y="392">CONSENSUS</text>
      <text x="82" y="416">DISAGREEMENT</text>
      <text x="82" y="440">SOURCE SUPPORT</text>
      <text x="82" y="464">UNCERTAINTY</text>
      <text x="82" y="488">RECOMMENDATION</text>
    </g>
    <g fill="#f2ebdd" opacity="0.55">
      <rect x="196" y="385" width="160" height="5" rx="2"></rect>
      <rect x="196" y="409" width="120" height="5" rx="2"></rect>
      <rect x="196" y="433" width="146" height="5" rx="2"></rect>
      <rect x="196" y="457" width="98" height="5" rx="2"></rect>
      <rect x="196" y="481" width="152" height="5" rx="2"></rect>
    </g>
    <rect x="196" y="409" width="120" height="5" rx="2" fill="#c99b3f" opacity="0.9"></rect>
  </g>
</svg>
