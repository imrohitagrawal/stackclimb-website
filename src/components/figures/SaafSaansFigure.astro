---
// SaafSaans's portrait: the sky as a standing column of CPCB bands, a person
// measured against it with their own risk ring, the best-window bracket, and
// the 21-station tick roll.
---

<svg class="figure" viewBox="0 0 420 600" role="img" aria-labelledby="ss-title">
  <title id="ss-title">
    A standing column of six air-quality bands from good to severe; a small human figure at
    its base carries a personal risk ring; a bracket marks the best window to go outside;
    a roll of 21 ticks marks the stations covered.
  </title>

  <!-- the sky column -->
  <g data-anchor="s-bands">
    <g>
      <rect x="150" y="36" width="150" height="74" fill="#efe7d2"></rect>
      <rect x="150" y="110" width="150" height="74" fill="#e3cfa0"></rect>
      <rect x="150" y="184" width="150" height="74" fill="#d3a868"></rect>
      <rect x="150" y="258" width="150" height="74" fill="#b87f45"></rect>
      <rect x="150" y="332" width="150" height="74" fill="#94582f"></rect>
      <rect x="150" y="406" width="150" height="74" fill="#6e3a28"></rect>
    </g>
    <g
      font-family="Archivo, Arial, sans-serif" font-size="10" font-weight="600"
      letter-spacing="1.2" fill="#f2ebdd"
    >
      <text x="310" y="78">GOOD</text>
      <text x="310" y="152">SATISFACTORY</text>
      <text x="310" y="226">MODERATE</text>
      <text x="310" y="300">POOR</text>
      <text x="310" y="374">VERY POOR</text>
      <text x="310" y="448">SEVERE</text>
    </g>
  </g>

  <!-- best-window bracket -->
  <g data-anchor="s-window">
    <path d="M144 40 L132 40 L132 180 L144 180" fill="none" stroke="#c99b3f" stroke-width="2"></path>
    <rect x="46" y="86" width="78" height="30" fill="#c99b3f"></rect>
    <text
      x="85" y="99" text-anchor="middle"
      font-family="Archivo, Arial, sans-serif" font-size="10" font-weight="700"
      letter-spacing="1.4" fill="#16213c"
    >BEST WINDOW</text>
    <text
      x="85" y="110" text-anchor="middle"
      font-family="Archivo, Arial, sans-serif" font-size="9.5" font-weight="700"
      fill="#16213c"
    >is forecast</text>
  </g>

  <!-- the person, measured personally -->
  <g data-anchor="s-person">
    <circle cx="96" cy="424" r="10" fill="#1a2733"></circle>
    <rect x="84" y="438" width="24" height="54" rx="11" fill="#1a2733"></rect>
    <circle cx="96" cy="458" r="40" fill="none" stroke="#c99b3f" stroke-width="1.5" stroke-dasharray="5 4"></circle>
    <text
      x="96" y="530" text-anchor="middle"
      font-family="Archivo, Arial, sans-serif" font-size="10" font-weight="600"
      letter-spacing="1.4" fill="#f2ebdd"
    >YOUR RISK — NOT THE CITY'S</text>
  </g>

  <!-- station roll -->
  <g data-anchor="s-stations" transform="translate(0 14)">
    <g fill="#f2ebdd" opacity="0.55">
      <rect x="330" y="490" width="14" height="4" rx="2"></rect>
      <rect x="348" y="490" width="14" height="4" rx="2"></rect>
      <rect x="366" y="490" width="14" height="4" rx="2"></rect>
      <rect x="330" y="500" width="14" height="4" rx="2"></rect>
      <rect x="348" y="500" width="14" height="4" rx="2"></rect>
      <rect x="366" y="500" width="14" height="4" rx="2"></rect>
      <rect x="330" y="510" width="14" height="4" rx="2"></rect>
      <rect x="348" y="510" width="14" height="4" rx="2"></rect>
      <rect x="366" y="510" width="14" height="4" rx="2"></rect>
      <rect x="330" y="520" width="14" height="4" rx="2"></rect>
      <rect x="348" y="520" width="14" height="4" rx="2"></rect>
      <rect x="366" y="520" width="14" height="4" rx="2"></rect>
      <rect x="330" y="530" width="14" height="4" rx="2"></rect>
      <rect x="348" y="530" width="14" height="4" rx="2"></rect>
      <rect x="366" y="530" width="14" height="4" rx="2"></rect>
      <rect x="330" y="540" width="14" height="4" rx="2"></rect>
      <rect x="348" y="540" width="14" height="4" rx="2"></rect>
      <rect x="366" y="540" width="14" height="4" rx="2"></rect>
      <rect x="330" y="550" width="14" height="4" rx="2"></rect>
      <rect x="348" y="550" width="14" height="4" rx="2"></rect>
    </g>
    <rect x="366" y="550" width="14" height="4" rx="2" fill="#c99b3f"></rect>
    <text
      x="384" y="578" text-anchor="end"
      font-family="Archivo, Arial, sans-serif" font-size="10" font-weight="600"
      letter-spacing="1.4" fill="#f2ebdd"
    >21 STATIONS, WORST-FIRST</text>
  </g>

  <!-- ground -->
  <rect x="60" y="496" width="252" height="2" fill="#f2ebdd" opacity="0.3"></rect>
</svg>
