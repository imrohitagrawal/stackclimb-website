---
/* D48: the owner's chevron mark, adopted by his decision 2026-08-09 over the
   comparison's recommendation. Ships with the baked #1a2338 background
   stripped to true transparency (approved) — shape and colours otherwise
   exactly his files. Imported so the asset is content-hashed, unlike /public
   (the DEF-24 trap). */
import brandMark from '../assets/brand-mark-nav.png';
/* Item 7. Real "StackClimb" wordmark, cropped from the owner's supplied
   dark-background/white variant to text only (the icon ships separately as
   brandMark, D48's own correction — this does not repeat it). Background
   stripped to transparency and downscaled the same way D48 did: distance-
   thresholded against the sampled corner colour, box (area-average) filter
   so it cannot overshoot. No recolouring — see docs/STATUS.md D55. */
import wordmark from '../assets/wordmark-nav.png';
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/palette.css';
import '../styles/shot.css';
import '../styles/caps.css';
import '../styles/touch.css';
import '../styles/print.css';
/* Phase 1 surfaces. Separate files because global.css stands at 494 lines
   against a grandfathered ceiling of 500 it may not exceed. */
import '../styles/avatar.css';
import '../styles/overview.css';
/* Item 4/5. Phase 2 motion — new file, same reason as the three above. */
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  /* Set on pages that are not a destination. A 404 must not declare itself
     canonical — that tells a crawler the error page is a real resource worth
     indexing, and it is the reason a site ends up with "Page not found" in
     search results. Only 404.astro sets it today. */
  noindex?: boolean;
}

const {
  title = 'Rohit Agrawal — AI systems that show their work',
  description = 'Independent, inspectable AI systems built on citation, disclosed uncertainty, honest refusal, and release gates — by a principal-level engineer with 14+ years of production reliability. Live on stackclimb.com.',
  noindex = false,
} = Astro.props;

/* DEF-9. The canonical and og:url used to be the string
   "https://stackclimb.com/", hard-coded. With one page that was invisible.
   With /approach and /cv arriving it would tell Google that every page on the
   site IS the home page — the textbook way to make your own pages vanish from
   an index.

   Derived from Astro.url against the `site` in astro.config.mjs, so a new page
   cannot forget to set it and cannot set it wrong. Astro.site is guaranteed
   present because astro.config.mjs sets `site`; the fallback keeps `astro dev`
   working if it is ever removed.

   The `.html` strip is not cosmetic. Under build.format:'file' the build-time
   Astro.url.pathname is "/approach.html", but the URL that actually serves —
   and the one @astrojs/sitemap emits — is "/approach". Left alone, the
   canonical and the sitemap would name two different URLs for one page, which
   is the duplicate-content problem DEF-9 exists to prevent, reintroduced by
   the fix for it. Caught by diffing the two on a throwaway page before
   shipping, not by reading. */
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site ?? 'https://stackclimb.com',
).href;

/* DEF-42. The one list of destinations, rendered twice below — a flat row for
   wide viewports and a <details> panel for narrow ones. Two surfaces, ONE
   source: a hand-typed second copy would be the fourth hand-maintained list
   to silently narrow a surface or a gate (DEF-10 routes, DEF-44 plate ids,
   touch.css selectors). Add a destination here and both menus carry it;
   tests/nav-reach.spec.js then proves it is reachable at every viewport. */
const NAV = [
  { href: '/#overview', label: 'Systems' },
  { href: '/cv', label: 'CV' },
  { href: '/#contact', label: 'Contact' },
];
const EMAIL = 'mailto:rohit.ra.agrawal@gmail.com';
---

<!doctype html>
<html lang="en" style="--bg:#1b2440" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* An is:inline script that added a `js-ground` class lived here.
        Deleted 2026-08-09: the class gated exactly one CSS rule,
        `.js-ground .plate { background: transparent }`, and commit 75ea9a7 —
        the DEF-30 fix — deleted that rule on 08-08. Verified before removing:
        `grep -c js-ground dist/_astro/*.css` returns 0. It had been setting a
        class nothing read for a day.

        This also settles DEF-6, whose recorded mechanism was that this script
        "always succeeds" while plates.js can throw, so the pair fails open.
        With no CSS behind the class there was nothing to fail open into.
        The real fail-open was elsewhere and larger — see RCA-003.

        Worth keeping: this was the one script Astro's CSP support cannot hash
        automatically, so it is also the script that would have needed a
        hand-maintained hash. That is precisely the stale-hash trap DEF-19
        describes. Deleting it leaves the trap nowhere to live. */}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rohit Agrawal" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content="https://stackclimb.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Item 5. Read BEFORE first paint — no flash of the wrong state, same
        reason `--bg`/`data-theme` are set on <html> above. First real
        per-visitor preference this site persists. `prefers-reduced-motion`
        is NOT read here — it always wins at the CSS layer independently
        (motion.css, Artefact.astro, nav.css), never overridden by this
        toggle. */}
    <script is:inline>
      try {
        if (localStorage.getItem('motion') === 'off') {
          document.documentElement.dataset.motion = 'off';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <!--
    THESIS: A hiring manager meets a portfolio dressed as a portrait plate: every claim
    captioned, every caption wired by a leader line to the thing it names. Refuses both
    the dark-terminal and the white-grid portfolio defaults.
    OWN-WORLD: Flat painted backdrop per plate — ink navy, bordeaux, viridian, dusk blue,
    greyed mauve, linen; bone paper and ochre thread throughout; Bodoni Moda caps display;
    Archivo tracked-caps billing strips; double-ruled plate frames; swatch tags naming each
    plate's three coordinated colors.
    STORY: Read the thesis, scan the record ledger (gap disclosed in it), walk four system
    plates whose captions cite real gates and real states, end at contact. Believe the rigor
    because the page practices it.
    FIRST VIEWPORT: Left — display headline, lede naming Rohit, two CTAs, six-row record
    ledger. Right — full-length figure tailored from the systems' hues, garment billing
    strip beneath; plate frame Nº 00; hairline nav.
    FORM: Sapeur portrait plate — user-chosen challenger over assigned grounded #7; seed b720fd1a.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    {/* Targets THIS page's main region, never a named plate.
        It read href="/#overview" for a few hours, which was worse than the
        bare "#work" it replaced: on /cv the id does not exist, so the control
        stopped being a bypass mechanism and became a link that navigates the
        reader off the page. Lighthouse scored skip-link 0 on /cv and it was
        the whole 2-point accessibility gap.

        Neither axe nor tests/links.spec.js caught it. axe has no skip-link
        rule; my own gate resolves "/#overview" by loading / and finding
        #overview there, which it does. The rule a skip link must obey is
        "targets the CURRENT page", and the gate did not encode it. Now it
        does, and #main exists on every page by construction. */}
    <a class="skip" href="#main">Skip to content</a>

    {/* Every destination is root-relative, not a bare fragment (DEF-41).
        The full nav rework — WORK · APPROACH · CONTACT (D28) — waits for
        /approach to exist, so this menu never advertises a page that would
        404 (DEF-40).

        Two menus, one array (NAV above). CSS shows exactly one: the flat row
        at ≥901px, the <details> panel at ≤900px. The inactive copy is
        display:none, which also removes it from the accessibility tree, so
        assistive tech is offered a single menu. The <details> needs no
        JavaScript to open or navigate — nav.js only adds close-on-navigate,
        Escape, and click-outside, all enhancement (RCA-004). */}
    <header class="site-nav">
      {/* Item 7, reordered: chevron, then the real StackClimb wordmark
          image, then the personal name. Wordmark visible at every width
          (unlike the old lowercase `<em>` it replaces — docs/brand/README.md
          had the casing wrong). `.brand-name` hides below 900px in the SAME
          slot the old `<em>` did: measured, wordmark + name overflowed the
          bar at 390px (menu button right edge landed past the viewport) —
          the identity that drops on a phone flips to the wordmark, which
          still gives the link an accessible name alone. */}
      <a class="brand" href="/">
        <img class="brand-mark" src={brandMark.src} alt="" width="70" height="84" />
        <img class="wordmark" src={wordmark.src} alt="StackClimb" width="388" height="72" />
        <span class="brand-name">Rohit Agrawal</span>
      </a>
      <nav aria-label="Site">
        {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
        <a class="chip" href={EMAIL}>Email me</a>
      </nav>
      <details class="menu">
        <summary>Menu</summary>
        {/* Email leads the panel: at 390px the bar fits brand + one control,
            and the chip lost the coin toss to the menu button — 65.8px free
            at 390px, 35.8px at 360px, and the chip is 111px wide. It is
            first here, at a larger target than it had in the bar. */}
        <nav aria-label="Site">
          <a class="chip" href={EMAIL}>Email me</a>
          {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </details>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="colophon">
      {/* DEF-36. This line used to continue: "Built as a work sample — static Astro,
          self-hosted type, no trackers, no invented claims". Every clause described the
          site rather than him, and "work sample" told a recruiter the whole page was an
          exercise rather than a record. Deleted rather than rewritten: removing harmful
          words needs no skill, writing new ones does. Any replacement is Phase 0 work
          with brand-voice. A colophon may simply be a colophon. */}
      <p>© 2026 Rohit Agrawal · Bengaluru</p>
      {/* Item 5. docs/HANDOFF.md's spec: animation ON by default, a footer
          toggle, state persisted in localStorage. A real <button> with
          aria-pressed — no CSS-only mechanism can persist state across a
          page load, so unlike the mobile menu this is real script
          (src/scripts/motion-toggle.js), not enhancement over a working
          native control. */}
      <button
        type="button"
        class="motion-toggle"
        id="motion-toggle"
        aria-pressed="false"
      >
        Animation: <span data-motion-label>on</span>
      </button>
    </footer>

    <script>
      import '../scripts/plates.js';
      import '../scripts/nav.js';
      import '../scripts/motion-toggle.js';
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
