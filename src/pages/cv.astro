---
/* D31 — the CV is a page that prints cleanly, not a PDF upload.
 *
 * Why a page. A PDF goes stale silently and nobody notices; a page is
 * indexable, always current, and a recruiter can still print it to PDF and
 * forward it. That was the owner's call, approach B.
 *
 * D38 — the phone number is not here, and no clever workaround stands in for
 * it. Reveal-on-click JS (scrapers execute JS), the number as an image (OCR
 * reads it, screen readers cannot) and @media-print-only (the number stays in
 * the HTML source, so every scraper gets it and every human does not) are all
 * banned by name. Contact is email and LinkedIn, which is the normal shape of
 * a published CV.
 *
 * DEF-8 — six of seven plates print blank, bone on white paper. This page is
 * the one meant to be printed, so it carries the print rules itself rather
 * than waiting for the site-wide fix.
 *
 * Content lives in src/data/cv.js so this file stays presentation only and
 * both stay under the 250-line budget.
 */
import Layout from '../layouts/Layout.astro';
import '../styles/cv.css';
import '../styles/cv-print.css'; // D151: the paper half, split out so cv.css fits its ceiling
import {
  identity, summary, experience, projects, education, certifications, awards, skills,
} from '../data/cv.js';
import { pages as projectPages } from '../data/project-pages.js';

/* P-9. Slugs are hand-assigned (project-pages.js's keys don't derive
   mechanically from cv.js's names), but EXISTENCE is checked live against
   projectPages so a page added or removed there is picked up automatically —
   never a second hardcoded yes/no per project. */
const EVIDENCE_SLUGS = {
  CiteVyn: 'citevyn',
  'Quorum-AI': 'quorum',
  SaafSaans: 'saafsaans',
  'NarraTwin AI': 'narratwin',
};
function evidenceHref(name) {
  const slug = EVIDENCE_SLUGS[name];
  // Absolute (R-7): the print rule below prints the raw href verbatim — a
  // relative path is unresolvable off the page it was printed from.
  return slug && projectPages[slug] ? new URL(`/projects/${slug}`, Astro.site).href : null;
}
---

<Layout
  title={`${identity.name} — CV`}
  description={`Curriculum vitae of ${identity.name}: fourteen years of quality engineering and release governance across Oracle, Amazon, LimeRoad, Mobileum, Snapdeal and Subex, and independent AI systems built around evaluation gates.`}
>
  <article class="cv plate" id="cv">
    <header class="cv-head">
      <h1>{identity.name}</h1>
      <p class="cv-title">{identity.title}</p>
      <ul class="cv-contact">
        <li><a href={`mailto:${identity.email}`}>{identity.email}</a></li>
        <li><a href={identity.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={identity.github} rel="noopener">GitHub</a></li>
        <li class="plain">{identity.base}</li>
        <li class="plain">{identity.relocation}</li>
        <li class="plain">Work authorisation: {identity.authorisation}</li>
      </ul>
    </header>

    <section class="cv-section" aria-labelledby="s-summary">
      <h2 id="s-summary">In short</h2>
      {summary.map((p) => <p>{p}</p>)}
    </section>

    <section class="cv-section" aria-labelledby="s-exp">
      <h2 id="s-exp">Experience</h2>
      {/* Stated once here rather than repeated on every line. The site's voice
          rule is to label what is not proven, and a figure from inside a
          company cannot be checked from outside it. */}
      {/* P-25 (2026-08-27, owner's explicit directive): the approximate
          disclaimer is GONE from /cv, screen and print alike. His words: "It is
          not necessary to mention them as approximate on the CV ... these need
          not be present on the CV page on the website as well as on the
          downloaded PDF." A recruiter reads a CV, not a methods section, and a
          caveat boxed beside the achievement it qualifies costs credibility.
          P-16's approximate marking still governs the HOME PAGE act, which is
          where the site makes its claim about employer figures; this route no
          longer repeats it. The figures themselves are unchanged. */}
      {experience.map((job) => (
        <div class="cv-job">
          <div class="cv-job-head">
            <h3>{job.role} · <span class="org">{job.org}</span></h3>
            <span class="cv-dates">{job.from} — {job.to}</span>
          </div>
          <p class="cv-scope">{job.scope}</p>
          {job.points.length > 0 && (
            <ul>{job.points.map((pt) => <li>{pt}</li>)}</ul>
          )}
        </div>
      ))}
    </section>

    <section class="cv-section" aria-labelledby="s-proj">
      <h2 id="s-proj">Independent systems</h2>
      <p class="cv-note">
        Built since April 2026. Four of the six run a gate against themselves — that is the
        through-line, and it is the same discipline as the fourteen years above. Where a system
        has a disclosure rule instead, or nothing yet, the row says so rather than calling it a
        gate.
      </p>
      {/* P-9: each card is a native <details> — collapsed by default so the
          page stays a fast scan, no JS required to open it (DEF-1's bar,
          same pattern as the nav menu). A claim inside (gate or rule) gets
          an Evidence link to its /projects/<slug> page where one exists, or
          the Approximate label where it doesn't (EvalAxis: private.md's own
          rule is "described and never linked" — no repo to point to yet). */}
      {/* The project name stays PLAIN TEXT inside <summary> — axe's
          nested-interactive rule (WCAG 4.1.2) bars an <a> inside a native
          disclosure control, even though a mouse click still routes
          correctly; a screen reader gets one ambiguous focus stop instead
          of two clear ones. The live-product link moves into the body,
          alongside Evidence, as "Visit". */}
      {projects.map((p) => {
        const evidence = evidenceHref(p.name);
        const claim = p.gate || p.rule;
        return (
          <details class="cv-proj">
            <summary class="cv-job-head">
              <h3>{p.name}</h3>
              <span class="cv-state">{p.state}</span>
            </summary>
            <p>{p.what}</p>
            {/* A row with no gate prints none. Aegis carried "Too early to
                state one" UNDER a Gate label, which is an absence wearing
                the label — the same thing #overview's figure column already
                refused once. */}
            {p.gate && <p class="cv-gate"><span class="cv-gate-k">Gate</span> {p.gate}</p>}
            {p.rule && <p class="cv-gate"><span class="cv-gate-k">Rule</span> {p.rule}</p>}
            {p.href && <p class="cv-gate"><a href={p.href} rel="noopener">Visit</a></p>}
            {claim && (
              evidence
                ? <p class="cv-gate"><a href={evidence} rel="noopener">Evidence</a></p>
                : <p class="cv-gate"><strong>Approximate</strong></p>
            )}
          </details>
        );
      })}
    </section>

    <section class="cv-section cv-cols" aria-labelledby="s-skills">
      <h2 id="s-skills">Technical</h2>
      <dl>
        {skills.map((s) => (
          <div class="cv-row"><dt>{s.group}</dt><dd>{s.items}</dd></div>
        ))}
      </dl>
    </section>

    <section class="cv-section cv-cols" aria-labelledby="s-edu">
      <h2 id="s-edu">Education and certification</h2>
      <dl>
        <div class="cv-row">
          <dt>{education.year}</dt>
          <dd>{education.degree} — {education.school}</dd>
        </div>
        {certifications.map((c) => (
          <div class="cv-row">
            <dt>{c.year}</dt>
            <dd>{c.name} — {c.issuer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-section" aria-labelledby="s-awards">
      <h2 id="s-awards">Recognition</h2>
      {/* P-9: same reasoning as the Experience note above — an award citing a
          figure or a placement is unverifiable from outside, same category
          as the employer bullets, and gets the same label rather than a
          second link scheme. */}
      {/* P-25: the Recognition disclaimer is gone for the same reason. */}
      <ul>{awards.map((a) => <li>{a}</li>)}</ul>
    </section>

    <footer class="cv-foot">
      <a class="btn primary" href={`mailto:${identity.email}`}>Email me</a>
      <a class="btn ghost" href="/">The systems</a>
      <p class="cv-print-note">
        This page is the current version. Printing it produces a PDF you can forward.
      </p>
    </footer>
  </article>
</Layout>
