---
/* /experience — D57 clause 8, overruling D32: a bird's-eye career EVOLUTION,
 * not the CV restated (DEF-27 bars restating). Two plates: the arc, then
 * the record. The complete CV is reachable from here, via /cv — its print
 * stylesheet already produces a clean document (Print → Save as PDF); no
 * new binary ships (package-5 plan's amendment record: the v1 build-time
 * PDF collided with DEF-37 round 8's unconditional PDF/DOCX block).
 */
import Layout from '../layouts/Layout.astro';
import Plate from '../components/Plate.astro';
import { eras, closing } from '../data/eras.js';
import '../styles/experience.css';
/* .plate-grid.one-col / .plate-copy.wide — RCA-013: this page's markup
   carried both classes with neither styled, since only project.css defined
   them and this page never imported it. Fixed by importing the shared
   partial rather than project.css itself, which also carries .record and
   .proj-* rules scoped to the project-detail template. */
import '../styles/one-col.css';
---

<Layout
  title="Career evolution — Rohit Agrawal"
  description="Fourteen years across six employers, from customer-facing quality work
    to AI-assisted release governance. The arc, not the resume — the full record is
    one click away."
>
  <Plate id="evolution">
    <div class="plate-grid one-col">
      <div class="plate-copy wide">
        <h1 class="plate-title tight">Fourteen years.</h1>
        <ol class="era-list">
          {eras.map((e) => (
            <li class="era">
              {/* RCA-013 (P3): era-dates used to be an inline <span> inside
                  era-org's own <p>, inheriting global.css's 52ch cap and
                  inline flow — at narrow widths the combined org+role+dates
                  text wrapped mid-phrase, orphaning the date range with
                  nothing to anchor it. A sibling <p> is its own block, so it
                  never shares a wrapped run with era-org, at any width. */}
              <p class="era-org">{e.job.org} — {e.job.role}</p>
              <p class="era-dates">{e.job.from} – {e.job.to}</p>
              <p class="era-line">{e.line}</p>
            </li>
          ))}
        </ol>
        <p class="era-closing">{closing}</p>
      </div>
    </div>
  </Plate>

  <Plate id="evolution-record">
    <div class="plate-grid one-col">
      <div class="plate-copy wide">
        <h2 class="plate-title tight">The full record</h2>
        <p>
          {/* RCA-011: this used to promise "every approximate figure marked as such" — P-25
              (2026-08-27) removed every approximate marking from /cv, so that clause became
              false the day it was written. Dropped rather than reworded around a rule that no
              longer applies to the page it describes. */}
          Every employer, every dated bullet — the complete CV lives on one page.
        </p>
        <div class="ctas">
          <a class="btn primary" href="/cv">Read or print the CV</a>
          <a class="btn ghost" href="/#systems">What I built</a>
        </div>
      </div>
    </div>
  </Plate>
</Layout>
