---
import Layout from '../layouts/Layout.astro';
import Plate from '../components/Plate.astro';
import CapStrip from '../components/CapStrip.astro';
import Ledger from '../components/Ledger.astro';
import HeroFigure from '../components/figures/HeroFigure.astro';
import CiteVynFigure from '../components/figures/CiteVynFigure.astro';
import QuorumFigure from '../components/figures/QuorumFigure.astro';
import SaafSaansFigure from '../components/figures/SaafSaansFigure.astro';
import NarraTwinFigure from '../components/figures/NarraTwinFigure.astro';
import PrivateFigure from '../components/figures/PrivateFigure.astro';
---

<Layout>
  <!-- Plate Nº 00 — the sitter -->
  <Plate
    id="top"
    num="00"
    name="The Record"
    hue="#1b2440"
    class="hero"
    chips={[
      { role: 'Ground', name: 'Ink navy', hex: '#1b2440' },
      { role: 'Cloth', name: 'Bone', hex: '#f2ebdd' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h1>AI that <span class="accent">shows</span> its work</h1>
        <p class="lede">
          <strong>Rohit Agrawal</strong> — principal-level engineer, fourteen years across
          distributed systems and production reliability, now building independent AI systems
          that cite their sources, disclose their uncertainty, refuse what they cannot
          support, and gate their own releases.
        </p>
        <div class="ctas">
          <a class="btn primary" href="#work">View the systems</a>
          <a class="btn ghost" href="mailto:rohit.ra.agrawal@gmail.com">Email me</a>
        </div>
        <Ledger
          label="The record"
          rows={[
            { t: 'Experience', d: '14+ yrs — Oracle, Amazon, LimeRoad, Mobileum, Snapdeal, Subex' },
            { t: 'Most recent', d: 'Oracle Principal MTS · 2019–2026' },
            { t: 'Since April 2026', d: 'Building independent AI systems, full time' },
            {
              t: 'Seeking',
              d: 'Senior / Principal — AI Platform · LLMOps · Forward-Deployed AI · AI Quality Engineering Architect · AI Test Automation & Agentic AI Leader',
            },
            { t: 'Base', d: 'Bengaluru, India · IST (UTC+5:30)' },
            { t: 'Relocation', d: 'Open worldwide' },
          ]}
        />
      </div>
      <figure class="plate-figure">
        <HeroFigure />
        <CapStrip
          label="The portfolio, worn as a suit — each garment is a system"
          items={[
            { t: 'Jacket', d: 'CiteVyn', href: '#work', target: 'g-citevyn' },
            { t: 'Jacket', d: 'Quorum-AI', href: '#quorum', target: 'g-quorum' },
            { t: 'Vest', d: 'SaafSaans', href: '#saafsaans', target: 'g-saafsaans' },
            { t: 'Trousers', d: 'NarraTwin', href: '#narratwin', target: 'g-narratwin' },
            { t: 'Pocket sq.', d: 'Private work', href: '#private', target: 'g-private' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 01 — CiteVyn -->
  <Plate
    id="work"
    num="01"
    name="CiteVyn"
    hue="#5e2233"
    chips={[
      { role: 'Ground', name: 'Bordeaux', hex: '#5e2233' },
      { role: 'Cloth', name: 'Bone', hex: '#f2ebdd' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">CiteVyn</h2>
        <p class="q">“Can I trust this answer — and trace every claim to its source?”</p>
        <p>
          Citation-grounded Q&amp;A over official AI documentation. Answers quote their sources
          verbatim; where no source supports an answer, CiteVyn refuses instead of guessing.
          Index updates reach production only through an evaluation gate.
        </p>
        <div class="links">
          <a href="https://citevyn.stackclimb.com" target="_blank" rel="noopener">Use it live</a>
          <a href="https://github.com/imrohitagrawal/citevyn" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/citevyn/blob/3d28fc8bf7a9de1903881ea7211ecb79a6f79eb5/docs/ARCHITECTURE.md"
            target="_blank"
            rel="noopener">Architecture</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <CiteVynFigure />
        <CapStrip
          label="CiteVyn, captioned"
          items={[
            { t: 'State', d: 'Live — cold-starts' },
            { t: 'Answers', d: 'Quoted verbatim', target: 'cite-quote' },
            { t: 'Citations', d: 'Every claim', target: 'cite-tabs' },
            { t: 'Refusal', d: 'A feature', target: 'cite-refusal' },
            { t: 'Release gate', d: '50/50 golden', target: 'cite-gate' },
            { t: 'Tests', d: '361 passing' },
            { t: 'Stack', d: 'FastAPI · pgvector' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 02 — Quorum-AI -->
  <Plate
    id="quorum"
    num="02"
    name="Quorum-AI"
    hue="#1e4f46"
    chips={[
      { role: 'Ground', name: 'Viridian', hex: '#1e4f46' },
      { role: 'Cloth', name: 'Bone', hex: '#f2ebdd' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">Quorum‑AI</h2>
        <p class="q">“What happens when four models disagree about your question?”</p>
        <p>
          One question runs against four models in parallel; they critique one another for two
          rounds, and a synthesis returns consensus, disagreement, source support, uncertainty,
          and a recommendation. The cost is approved before anything runs, and any fallback or
          simulation is disclosed, never hidden.
        </p>
        <div class="links">
          <a href="https://quorum.stackclimb.com" target="_blank" rel="noopener">Use it live</a>
          <a href="https://github.com/imrohitagrawal/quorum-ai" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/quorum-ai/blob/303228262d7697793a268550a3b287d27f1a1584/docs/20-architecture.md"
            target="_blank"
            rel="noopener">Architecture</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <QuorumFigure />
        <CapStrip
          label="Quorum-AI, captioned"
          items={[
            { t: 'State', d: 'Live' },
            { t: 'Models', d: '4 in parallel', target: 'q-models' },
            { t: 'Debate', d: '2 critique rounds', target: 'q-debate' },
            { t: 'Verdict', d: '5 fields', target: 'q-synth' },
            { t: 'Cost', d: 'Approved first', target: 'q-cost' },
            { t: 'Memory', d: 'None — ephemeral' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 03 — SaafSaans -->
  <Plate
    id="saafsaans"
    num="03"
    name="SaafSaans"
    hue="#2e5877"
    chips={[
      { role: 'Ground', name: 'Dusk blue', hex: '#2e5877' },
      { role: 'Cloth', name: 'Bone', hex: '#f2ebdd' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">SaafSaans</h2>
        <p class="q">“Is it safe for me to go outside right now — and if not, when?”</p>
        <p>
          A Delhi-NCR air-quality companion that scores your risk — age, condition, planned
          activity — rather than the city's average, across 21 stations, and answers questions
          with cited health guidance. Every mode is labelled: live, deterministic fallback, or
          sample. The Hindi draft ships behind a banner saying no Hindi speaker has reviewed it
          yet.
        </p>
        <p>
          Started at <em>Build with AI</em> (Elastic × GDG Cloud New Delhi, 18 July 2026) as a
          three-hour build, then rebuilt over the following four days into what runs today. It
          lives on one small machine that scales to zero when idle. <strong>Right now that
          machine is not answering</strong> — the certificate is valid and the address resolves,
          so the fault is being investigated. This page says so rather than leaving you to find
          out by clicking.
        </p>
        <div class="links">
          <a href="https://saafsaans.stackclimb.com" target="_blank" rel="noopener">Deployment (down)</a>
          <a href="https://github.com/imrohitagrawal/saaf-saans" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/saaf-saans/blob/3bac09012cc1a5e36d24505e54d6155ff0664aa3/docs/CASE-STUDY.md"
            target="_blank"
            rel="noopener">Case study</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <SaafSaansFigure />
        <CapStrip
          label="SaafSaans, captioned"
          items={[
            { t: 'State', d: 'Deployed' },
            { t: 'Risk', d: 'Per person', target: 's-person' },
            { t: 'Scale', d: 'CPCB bands', target: 's-bands' },
            { t: 'Timing', d: 'Best window', target: 's-window' },
            { t: 'Coverage', d: '21 stations', target: 's-stations' },
            { t: 'Hindi', d: 'Gated — unreviewed' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 04 — NarraTwin -->
  <Plate
    id="narratwin"
    num="04"
    name="NarraTwin"
    hue="#4a4653"
    chips={[
      { role: 'Ground', name: 'Greyed mauve', hex: '#4a4653' },
      { role: 'Cloth', name: 'Bone', hex: '#f2ebdd' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title tight">NarraTwin AI</h2>
        <p class="q">“Can project knowledge become a walkthrough without inventing a claim?”</p>
        <p>
          Grounded walkthrough generation with citations, claim evaluation, consent checks, and
          release gates that run before anything is generated. Its own release-readiness review
          currently reads No-Go — so it is not deployed, and this page says so.
        </p>
        <p>It is shown anyway, because the gate holding is the point.</p>
        <div class="links">
          <a href="https://github.com/imrohitagrawal/narratwin-ai" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/narratwin-ai/blob/454025c403334933306142f65bc3e25541eeb23e/docs/RELEASE_READINESS_REVIEW.md"
            target="_blank"
            rel="noopener">Release readiness review</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <NarraTwinFigure />
        <CapStrip
          label="NarraTwin, captioned"
          items={[
            { t: 'State', d: 'Phase 1 — No-Go', target: 'n-gate' },
            { t: 'Gates', d: 'Claim · consent · release', target: 'n-latches' },
            { t: 'Deployment', d: 'None — local only', target: 'n-frame' },
            { t: 'Distribution', d: 'Withheld by design' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 05 — the private work, on unpainted linen -->
  <Plate
    id="private"
    num="05"
    name="Kept Close"
    hue="#b5ac9c"
    theme="light"
    chips={[
      { role: 'Ground', name: 'Linen', hex: '#b5ac9c' },
      { role: 'Cloth', name: 'Olive', hex: '#8f8672' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">Carried, not shown</h2>
        <p>
          Two systems are still being built. They stay closed until they can be judged on
          finished work rather than on intent. They are named because a record that discloses
          its gaps should also say what exists — and the question each one is built to answer
          costs nothing to state.
        </p>
        <div class="private-pair">
          <div class="private-card">
            <h3>EvalAxis</h3>
            <p class="q">
              “Why can a failing test stop a release, when a measured drop in answer quality
              cannot?”
            </p>
            <p>
              Evaluates LLM, RAG, and agent changes with evidence — and blocks CI on a quality
              regression.
            </p>
            <span class="seal">In progress · closed</span>
          </div>
          <div class="private-card">
            <h3>Aegis Contracts</h3>
            <p class="q">“What should one AI system be allowed to promise another — and who checks?”</p>
            <p>Early-stage work on contract-shaped guarantees between AI systems.</p>
            <span class="seal">In progress · closed</span>
          </div>
        </div>
      </div>
      <figure class="plate-figure">
        <PrivateFigure />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 06 — contact -->
  <Plate
    id="contact"
    num="06"
    name="The Sitting"
    hue="#1b2440"
    class="contact"
    chips={[
      { role: 'Ground', name: 'Ink navy', hex: '#1b2440' },
      { role: 'Cloth', name: 'Bone', hex: '#f2ebdd' },
      { role: 'Thread', name: 'Ochre', hex: '#c99b3f' },
    ]}
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">One message away</h2>
        <p>
          Open to senior and principal roles in Forward-Deployed AI, AI Platform Engineering,
          and LLMOps / AI Reliability — and closely aligned AI quality and platform work.
        </p>
        <div class="ctas">
          <a class="btn primary" href="mailto:rohit.ra.agrawal@gmail.com">Email me</a>
          <a class="btn ghost" href="https://www.linkedin.com/in/rohitagrawal14" target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn ghost" href="https://github.com/imrohitagrawal" target="_blank" rel="noopener">GitHub</a>
        </div>
        {/* The three destinations above are already labelled links. Repeating them
            here as plain text was a duplicate a visitor could not click. These two
            rows carry facts the paragraph was burying instead. Terms stay sentence
            case — global.css applies text-transform: uppercase. */}
        <Ledger
          label="Where"
          rows={[
            { t: 'Based', d: 'Bengaluru, India · IST (UTC+5:30)' },
            { t: 'Open to', d: 'Global relocation · international travel' },
          ]}
        />
      </div>
    </div>
  </Plate>
</Layout>
