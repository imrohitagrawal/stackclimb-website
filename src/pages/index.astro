---
import Layout from '../layouts/Layout.astro';
import Plate from '../components/Plate.astro';
import CapStrip from '../components/CapStrip.astro';
import Ledger from '../components/Ledger.astro';
import Artefact from '../components/figures/Artefact.astro';
import PrivateFigure from '../components/figures/PrivateFigure.astro';
import Overview from '../components/Overview.astro';
---

<Layout>
  <!-- Plate Nº 00 — the sitter -->
  <Plate
    id="top"
    num="00"
    name="The Record"
    class="hero"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h1>AI that <span class="accent">shows</span> its work</h1>
        {/* Phase 0 applied — docs/positioning-phase0.md.
            The lede used to read "…fourteen years across distributed systems and
            production reliability, NOW building independent AI systems". Read
            cold that says career changer, eight months in — the weakest reading
            of his strongest fact. The fourteen years are now the setup for the
            punchline rather than the thing before it. Same facts, no new claim.

            D27 — the avatar sits beside the name, not above the headline. The
            hero plate was already 191px over a 900px viewport, and this is the
            only placement that fits without dropping the proof card. */}
        <p class="lede">
          <img
            class="avatar"
            src="/rohit-agrawal.webp"
            width="176"
            height="176"
            alt=""
            loading="eager"
            decoding="async"
          />
          <strong class="lede-name">Rohit Agrawal</strong> — principal engineer, fourteen years
          deciding whether software was safe to release, now building AI systems that make that
          decision about themselves. Citation, disclosed uncertainty, honest refusal, and
          evaluation gates that can block a release.
        </p>
        <div class="ctas">
          <a class="btn primary" href="#overview">What he built</a>
          <a class="btn ghost" href="/cv">CV</a>
          <a class="btn ghost" href="mailto:rohit.ra.agrawal@gmail.com">Email me</a>
        </div>
      </div>
      {/* The ledger is a sibling of the copy, not a child, so that on a phone
          the artefact can sit between the buttons and the career facts. The
          proof of the headline should be seen before the CV detail, and it
          used to be twelve screens down. */}
      {/* Phase 0, item 0.5. `Seeking` listed FIVE job titles, which reads as
          "does not know what he wants" in a thirty-second skim. One slot a
          recruiter recognises, with the specialism attached — a title too narrow
          to search reads as "not my req", which is the opposite failure and just
          as expensive.

          DEF-29 closed here too. `Base — Bengaluru, India · IST (UTC+5:30)` was
          stated verbatim in this ledger AND in the contact ledger. Same defect
          class as DEF-27, same resolution: the row carrying strictly more
          survives, and the contact ledger also states international travel. The
          `Relocation` row goes with it — DEF-27's fix had REGRESSED, and both
          ledgers were stating relocation again.

          `Led` is new. D32 measured that "led and mentored 11+ engineers"
          appeared ZERO times on the live site, and for senior and principal
          roles scope of responsibility is often the first filter. */}
      <div class="hero-ledger">
        <Ledger
          label="The record"
          rows={[
            { t: 'Experience', d: '14+ yrs — Oracle, Amazon, LimeRoad, Mobileum, Snapdeal, Subex' },
            { t: 'Most recent', d: 'Oracle Principal MTS · 2019–2026' },
            { t: 'Since April 2026', d: 'Building independent AI systems, full time' },
            { t: 'Led', d: '11+ quality engineers and SDETs, globally' },
            {
              t: 'Seeking',
              d: 'Senior / Principal — AI Platform Engineering, with evaluation and release governance',
            },
          ]}
        />
      </div>
      <div class="plate-figure">
        <Artefact
          kind="CiteVyn, golden case claude_api_006"
          verdict="Refused"
          tone="fail"
          line="“What is the capital of France?”"
          fields={[
            { k: 'citations', v: '0' },
            { k: 'domain', v: 'unsupported' },
            { k: 'confidence', v: 'none' },
            { k: 'answered', v: 'No — by policy' },
          ]}
          source="It plainly knows the answer and refuses anyway, because no indexed source supports it. Verbatim from citevyn/backend/artifacts/golden_report.json, recorded 17 July 2026."
        />
      </div>
    </div>
  </Plate>

  {/* Plate Nº 01 — the contact sheet. O-OVERVIEW / D1, decided 07 Aug and
      unexecuted until now. It is the answer to the measured problem that the
      first viewport said nothing about what any system does. */}
  <Plate
    id="overview"
    num="01"
    name="The Contact Sheet"
    state="Six systems"
  >
    <div class="plate-grid one-col">
      <div class="plate-copy wide">
        <h2 class="plate-title">What he built</h2>
        <Overview />
      </div>
    </div>
  </Plate>

  {/* DEF-34. This plate's id was `work`, while the nav label said `Systems` and
      the skip link said "Skip to the systems" — a plural label landing the
      visitor on ONE system. `work` was also the odd id out: every other plate is
      named for its project. Renamed to `citevyn`; the nav's "Systems" link and
      the skip link now point at `#overview` above, which is what a plural label
      should actually reach. */}
  <Plate
    id="citevyn"
    num="02"
    name="CiteVyn"
    state="Live — cold-starts"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">CiteVyn</h2>
        <p class="q">“Can I trust this answer — and trace every claim to its source?”</p>
        <p>
          Citation-grounded Q&amp;A over official AI documentation. Answers quote their sources
          verbatim; where no source supports an answer, CiteVyn refuses instead of guessing.
          Index updates reach production only through an evaluation gate.
        </p>
        <div class="links">
          <a href="https://citevyn.stackclimb.com" target="_blank" rel="noopener">Use it live</a>
          <a href="https://github.com/imrohitagrawal/citevyn" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/citevyn/blob/3d28fc8bf7a9de1903881ea7211ecb79a6f79eb5/docs/ARCHITECTURE.md"
            target="_blank"
            rel="noopener">Architecture</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <Artefact
          kind="Golden regression run"
          verdict="52 / 52 passed"
          tone="pass"
          line="A red case blocks the index from reaching production."
          fields={[
            { k: 'cases', v: '52' },
            { k: 'failed', v: '0' },
            { k: 'run', v: '17 Jul 2026' },
            { k: 'gate', v: 'Blocks promotion' },
          ]}
          source="citevyn/backend/artifacts/golden_report.json at df8cfc3. Read from the recorded run, not restated."
        />
        <CapStrip
          label="CiteVyn, captioned"
          items={[
            { t: 'Answers', d: 'Quoted verbatim' },
            { t: 'Citations', d: 'Every claim' },
            { t: 'Refusal', d: 'A feature' },
            { t: 'Release gate', d: '52 golden cases' },
            { t: 'Tests', d: '1,036 defined' },
            { t: 'Stack', d: 'FastAPI · pgvector' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 03 — Quorum-AI -->
  <Plate
    id="quorum"
    num="03"
    name="Quorum-AI"
    state="Live"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">Quorum‑AI</h2>
        <p class="q">“What happens when four models disagree about your question?”</p>
        <p>
          One question runs against four models in parallel; they critique one another for two
          rounds, and a synthesis returns consensus, disagreement, source support, uncertainty,
          and a recommendation. The cost is approved before anything runs, and any fallback or
          simulation is disclosed, never hidden.
        </p>
        <div class="links">
          <a href="https://quorum.stackclimb.com" target="_blank" rel="noopener">Use it live</a>
          <a href="https://github.com/imrohitagrawal/quorum-ai" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/quorum-ai/blob/303228262d7697793a268550a3b287d27f1a1584/docs/20-architecture.md"
            target="_blank"
            rel="noopener">Architecture</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <Artefact
          kind="Production readiness review"
          verdict="Go"
          tone="pass"
          line="The review before it said No-Go. That one is kept too."
          fields={[
            { k: 'decision', v: 'Go — single instance' },
            { k: 'dated', v: '21 Jun 2026' },
            { k: 'scope', v: 'MVP, small user base' },
            { k: 'superseded', v: 'No-Go of 16 Jun' },
          ]}
          source="quorum-ai/docs/95-production-readiness-review.md at 8ca6a98. Both decisions are in the file; neither was removed."
        />
        <CapStrip
          label="Quorum-AI, captioned"
          items={[
            { t: 'Models', d: '4 in parallel' },
            { t: 'Debate', d: '2 critique rounds' },
            { t: 'Verdict', d: '5 fields' },
            { t: 'Cost', d: 'Approved first' },
            { t: 'Memory', d: 'None — ephemeral' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 04 — SaafSaans -->
  <Plate
    id="saafsaans"
    num="04"
    name="SaafSaans"
    state="Deployed — not answering"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">SaafSaans</h2>
        <p class="q">“Is it safe for me to go outside right now — and if not, when?”</p>
        <p>
          A Delhi-NCR air-quality companion that scores your risk — age, condition, planned
          activity — rather than the city's average, across 21 stations, and answers questions
          with cited health guidance. Every mode is labelled: live, deterministic fallback, or
          sample. The Hindi draft ships behind a banner saying no Hindi speaker has reviewed it
          yet.
        </p>
        <p>
          Entered at <em>Build with AI</em> (Elastic × GDG Cloud New Delhi, 18 July 2026) as a
          four-tab Streamlit app that already existed, then rebuilt over the next three days
          into what runs today. It lives on one small machine that scales to zero when idle.
          <strong>Right now that machine is not answering</strong> — the address resolves and
          the server accepts the connection, then closes it without sending anything. The fault
          is being investigated. This page says so rather than leaving you to find out by
          clicking.
        </p>
        <div class="links">
          <a href="https://saafsaans.stackclimb.com" target="_blank" rel="noopener">Deployment (down)</a>
          <a href="https://github.com/imrohitagrawal/saaf-saans" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/saaf-saans/blob/3bac09012cc1a5e36d24505e54d6155ff0664aa3/docs/CASE-STUDY.md"
            target="_blank"
            rel="noopener">Case study</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <Artefact
          kind="Measured at head, today"
          verdict="Counted, not claimed"
          tone="neutral"
          line="Every number here has a command that checks it."
          fields={[
            { k: 'test functions', v: '628' },
            { k: 'test files', v: '32' },
            { k: 'seeded advisories', v: '43' },
            { k: 'commits', v: '161' },
          ]}
          source="saaf-saans at 5e5037a, counted on 8 Aug 2026. Its own case study lists 25 files and 117 commits — true at an older commit, and stale now. That is why these were re-counted rather than copied."
        />
        <CapStrip
          label="SaafSaans, captioned"
          items={[
            { t: 'Risk', d: 'Per person' },
            { t: 'Scale', d: 'CPCB bands' },
            { t: 'Timing', d: 'Best window' },
            { t: 'Coverage', d: '21 stations' },
            { t: 'Hindi', d: 'Gated — unreviewed' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 05 — NarraTwin -->
  <Plate
    id="narratwin"
    num="05"
    name="NarraTwin"
    state="Phase 1 — No-Go"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title tight">NarraTwin AI</h2>
        <p class="q">“Can project knowledge become a walkthrough without inventing a claim?”</p>
        <p>
          Grounded walkthrough generation with citations, claim evaluation, consent checks, and
          release gates that run before anything is generated. Its own release-readiness review
          currently reads No-Go — so it is not deployed, and this page says so.
        </p>
        <p>It is shown anyway, because the gate holding is the point.</p>
        <div class="links">
          <a href="https://github.com/imrohitagrawal/narratwin-ai" target="_blank" rel="noopener">Source</a>
          <a
            href="https://github.com/imrohitagrawal/narratwin-ai/blob/454025c403334933306142f65bc3e25541eeb23e/docs/RELEASE_READINESS_REVIEW.md"
            target="_blank"
            rel="noopener">Release readiness review</a
          >
        </div>
      </div>
      <figure class="plate-figure">
        <Artefact
          kind="Release readiness review"
          verdict="No-Go"
          tone="fail"
          line="No-Go for production release. No release tag has been created."
          fields={[
            { k: 'dated', v: '1 Jul 2026' },
            { k: 'release tags', v: '0' },
            { k: 'blocked', v: 'Paid providers, video export' },
            { k: 'allowed', v: 'Local mock demo' },
          ]}
          source="narratwin docs/RELEASE_READINESS_REVIEW.md at 2ce5731. The repo has two tags; both mark stages, neither is a release."
        />
        <CapStrip
          label="NarraTwin, captioned"
          items={[
            { t: 'Gates', d: 'Claim · consent · release' },
            { t: 'Deployment', d: 'None — local only' },
            { t: 'Distribution', d: 'Withheld by design' },
          ]}
        />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 06 — the private work, on unpainted linen -->
  <Plate
    id="private"
    num="06"
    name="Kept Close"
    state="In progress — closed"
    theme="light"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">Carried, not shown</h2>
        <p>
          Two systems are still being built. They stay closed until they can be judged on
          finished work rather than on intent. They are named because a record that discloses
          its gaps should also say what exists — and the question each one is built to answer
          costs nothing to state.
        </p>
        <div class="private-pair">
          <div class="private-card">
            <h3>EvalAxis</h3>
            <p class="q">
              “Why can a failing test stop a release, when a measured drop in answer quality
              cannot?”
            </p>
            <p>
              Evaluates LLM, RAG, and agent changes with evidence — and blocks CI on a quality
              regression.
            </p>
            <span class="seal">In progress · closed</span>
          </div>
          <div class="private-card">
            <h3>Aegis Contracts</h3>
            <p class="q">“What should one AI system be allowed to promise another — and who checks?”</p>
            <p>Early-stage work on contract-shaped guarantees between AI systems.</p>
            <span class="seal">In progress · closed</span>
          </div>
        </div>
      </div>
      <figure class="plate-figure">
        <PrivateFigure />
      </figure>
    </div>
  </Plate>

  <!-- Plate Nº 07 — contact -->
  <Plate
    id="contact"
    num="07"
    name="The Sitting"
    class="contact"
  >
    <div class="plate-grid">
      <div class="plate-copy">
        <h2 class="plate-title">One message away</h2>
        <p>
          Open to senior and principal roles in Forward-Deployed AI, AI Platform Engineering,
          and LLMOps / AI Reliability — and closely aligned AI quality and platform work.
        </p>
        <div class="ctas">
          <a class="btn primary" href="mailto:rohit.ra.agrawal@gmail.com">Email me</a>
          <a class="btn ghost" href="https://www.linkedin.com/in/rohitagrawal14" target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn ghost" href="https://github.com/imrohitagrawal" target="_blank" rel="noopener">GitHub</a>
        </div>
        {/* The three destinations above are already labelled links. Repeating them
            here as plain text was a duplicate a visitor could not click. These two
            rows carry facts the paragraph was burying instead. Terms stay sentence
            case — global.css applies text-transform: uppercase. */}
        <Ledger
          label="Where"
          rows={[
            { t: 'Based', d: 'Bengaluru, India · IST (UTC+5:30)' },
            { t: 'Open to', d: 'Global relocation · international travel' },
          ]}
        />
      </div>
    </div>
  </Plate>
</Layout>
