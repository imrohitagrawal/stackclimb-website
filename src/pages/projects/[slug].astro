---
/* /projects/<slug> — one page per system that carries an artefact.
 *
 * Four routes, generated from src/data/projects.js. A new system needs a data entry
 * and an image, not an edit here — the same rule Shot.astro follows for its glob.
 *
 * THREE PLATES. DESIGN.md:228: "content that cannot fit becomes another plate, not a
 * taller one." Plate 1 is the claim and the artefact; plate 2 is the record. Putting
 * both in one plate measured 1,082px against a 900px viewport, which is the rule's own
 * failure case. Plate 3 (P-10) is the giscus comment thread — its own plate for the
 * same reason, not appended to the already height-tuned record plate.
 *
 * The plate id equals the slug, so palette.css paints each page in its system's own
 * livery with no rule added anywhere.
 *
 * D62 resolved here. It read "artefact panel on the home band, screenshot on the
 * project page" and was decided before project pages existed. Now that they do:
 * each system's capture stays on its home plate AND at full size here — the home
 * plate uses the crop where the full image would push it past one screen — and the
 * three-column record, which the home page has no room for, is what the click buys.
 */
import Layout from '../../layouts/Layout.astro';
import Plate from '../../components/Plate.astro';
import CapStrip from '../../components/CapStrip.astro';
import Record from '../../components/Record.astro';
import Shot from '../../components/figures/Shot.astro';
import { projects } from '../../data/projects.js';
import { pages } from '../../data/project-pages.js';
import '../../styles/project.css';
/* .sys-gate and .sys-nc — the two cells plate 1 gained in package B. */
import '../../styles/systems.css';

export function getStaticPaths() {
  return Object.keys(projects).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = projects[slug];
const page = pages[slug];

/* A route can only exist because `projects` has the key, but `pages` is a second
   file and could fall behind it. Fail the BUILD rather than ship a page with no
   record — a project page without its record is the duplicate of its home plate. */
if (!page) {
  throw new Error(
    `[slug].astro: no entry in project-pages.js for "${slug}". Every project in ` +
      'projects.js needs one, or its page is just the home plate again.',
  );
}

/* Derived, never restated — so the page and the caption strip cannot disagree. */
const notClaimed = p.notClaimed.split('·').map((s) => s.trim()).filter(Boolean);

/* The meta description was `p.alt` — the IMAGE alt text. On Quorum that is a
   description of a SAMPLE fixture panel, so the page and every social card
   published "4 of 4 models aligned · 3 revised their position" and "13%" as
   plain fact, stripped of the caption that labels them canned data. The first
   body paragraph is the system's own description and carries no figures. */
const desc = page.body[0]
  .replace(/<[^>]+>/g, '')
  /* Entities too: body[0] is authored for set:html, and Astro escapes the
     attribute again — "Q&amp;A" was shipping as "Q&amp;amp;A" in the meta tag. */
  .replace(/&amp;/g, '&')
  .replace(/&ldquo;/g, '\u201c')
  .replace(/&rdquo;/g, '\u201d')
  .replace(/&rsquo;/g, '\u2019')
  .slice(0, 300);
---

<Layout
  title={`${p.name} — Rohit Agrawal`}
  description={desc}
>
  <Plate
    id={slug}
    state={p.state}
  >
    <div class="plate-grid">
      {/* Package B3. Plate 1 used to be a near-copy of the home plate: it repeated
          body[0] and the proof line verbatim while LOSING the Gate line and the Not
          claimed row (D77's recorded residual — "the first screen of the click buys
          less than the plate it came from"). Now it renders body.slice(1) — the
          material home defers — plus the two elements the click used to lose.
          body[0] stays home-only; the meta description above still derives from it
          in data. The record plate stays second: merging measured 1,082px against
          the 900px viewport (D76), and the owner confirmed elements-up on 08-14. */}
      <div class="plate-copy">
        <h1 class="plate-title tight">{p.name}</h1>
        <p class="q">{p.q}</p>
        {page.body.slice(1).map((b) => <p set:html={b} />)}
        <p class="sys-gate"><span class="k">{p.gate.k}</span>{p.gate.v}</p>
        <div class="links">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
          ))}
        </div>
      </div>
      <figure class="plate-figure">
        <Shot
          shot={p.shot}
          crop={p.crop}
          alt={p.alt}
          prov={p.prov}
        />
        <CapStrip
          label={`${slug}, counted`}
          items={p.strip}
        />
        {/* The landing summary; the record plate keeps its Not-claimed column as
            the comparison table — both on purpose, recorded in D80. */}
        <dl class="sys-nc">
          <dt>Not claimed</dt>
          <dd>{p.notClaimed}</dd>
        </dl>
      </figure>
    </div>
  </Plate>

  <Plate id={`${slug}-record`}>
    <div class="plate-grid one-col">
      <div class="plate-copy wide">
        <h2 class="plate-title tight">What it does, and what it refuses</h2>
        <Record
          now={page.record.now}
          gaps={page.record.gaps}
          notClaimed={notClaimed}
          note={p.eng}
        />
        <div class="ctas proj-back">
          <a class="btn ghost" href="/#systems">All systems</a>
          <a class="btn primary" href="mailto:rohit.ra.agrawal@gmail.com">Email me</a>
        </div>
      </div>
    </div>
  </Plate>

  {/* P-10. `data-mapping="specific"` + `data-term={slug}` — not `pathname` —
      binds the thread to the project's stable slug so a future route rename
      cannot orphan existing comments. The category is GitHub's own default
      `Announcements` (locked: only the repo owner starts a thread, visitors
      only reply) — no public API creates or renames a category, and the
      name itself never renders in the widget a visitor sees. */}
  <Plate id={`${slug}-comments`}>
    <div class="plate-grid one-col">
      <div class="plate-copy wide">
        <h2 class="plate-title tight">Discussion</h2>
        <p class="sys-note">
          Comments post to this repository's GitHub Discussions and need a GitHub
          account — the same account system the site's own code already lives in.
        </p>
        <div
          class="giscus"
          data-repo="imrohitagrawal/stackclimb-website"
          data-repo-id="R_kgDOTzbbEg"
          data-category="Announcements"
          data-category-id="DIC_kwDOTzbbEs4DDj8g"
          data-mapping="specific"
          data-term={slug}
          data-strict="1"
          data-reactions-enabled="1"
          data-theme="noborder_dark"
          data-lang="en"
        />
      </div>
    </div>
  </Plate>
  <script src="https://giscus.app/client.js" data-loading="lazy" crossorigin="anonymous" async></script>
</Layout>
